{
  "_comment": "DeepSeek 接入示例：文本创作与视觉复核走 DeepSeek，画面生成仍走智谱。用法: studio deliver --run <id> --config config.deepseek.json",
  "_note_vision_model": "必须用 deepseek-flash —— DeepSeek 当前只有它支持图片输入，deepseek-v4-pro 不支持 Vision。",

  "base_url": "https://open.bigmodel.cn/api/paas/v4",
  "api_key_env": "AI_API_KEY",
  "mock": true,

  "model": "deepseek-flash",
  "temperature": 0.8,
  "max_tokens": 4096,

  "models": {
    "texture": "cogvideox-3",
    "economy": "cogvideox-3",
    "vision": "deepseek-flash",
    "text": "deepseek-flash",
    "translate": "deepseek-flash"
  },

  "providers": {
    "text":   { "base_url": "https://api.deepseek.com", "api_key_env": "DEEPSEEK_API_KEY" },
    "vision": { "base_url": "https://api.deepseek.com", "api_key_env": "DEEPSEEK_API_KEY" },
    "image":  { "base_url": "https://open.bigmodel.cn/api/paas/v4", "api_key_env": "AI_API_KEY" },
    "video":  { "base_url": "https://open.bigmodel.cn/api/paas/v4", "api_key_env": "AI_API_KEY" },
    "tts":    { "base_url": "https://open.bigmodel.cn/api/paas/v4", "api_key_env": "AI_API_KEY" }
  },

  "vision_review": {
    "enabled": true,
    "sample_frames": 3,
    "pass_score": 7.5,
    "max_shots_per_request": 4,
    "max_review_shots": 0,
    "frame_width": 640
  },

  "pricing": {
    "text":      { "prompt_per_1k_tokens": 0.0002, "completion_per_1k_tokens": 0.0004 },
    "vision":    { "prompt_per_1k_tokens": 0.0002, "completion_per_1k_tokens": 0.0004 },
    "translate": { "prompt_per_1k_tokens": 0.0002, "completion_per_1k_tokens": 0.0004 },
    "image":     { "image_per_shot": 0.10 },
    "video":     { "video_per_sec": 0.20 },
    "tts":       { "tts_per_1k_chars": 0.10 }
  },

  "budget": {
    "max_cost_cny": 0,
    "warn_ratio": 0.8,
    "stop_on_no_fund": true
  },

  "video": {
    "model": "cogvideox-3",
    "quality_model": "cogvideox-3",
    "economy_model": "cogvideox-3",
    "default_quality": "quality",
    "size": "1920x1080",
    "fps": 30,
    "workers": 2,
    "timeout_minutes": 20,
    "shot_retries": 3,
    "rerender_rounds": 2,
    "with_audio": false,
    "image_to_image": true,
    "ref_size": "1024x1024",
    "watermark": false,
    "end_frame_anchor": true
  },

  "image": {
    "model": "glm-image",
    "size": "1248x704",
    "ref_size": "1024x1024",
    "quality": "",
    "watermark": false
  },

  "quality": {
    "min_sharpness": 55,
    "min_mean_luma": 18,
    "max_mean_luma": 238,
    "min_std_luma": 14,
    "max_face_ratio": 0.55,
    "min_face_ratio": 0.02,
    "max_subtitle_cps": 9.0,
    "max_subtitle_line_runes": 18,
    "max_subtitle_lines": 2,
    "duration_tolerance": 0.35,
    "max_cut_drift_sec": 1.5,
    "loudness_target_lufs": -14.0,
    "loudness_tolerance_lu": 1.5,
    "true_peak_db": -1.0
  },

  "audio": {
    "sample_rate": 24000,
    "channels": 2,
    "voice": "tongtong",
    "voice_map": {},
    "narrator_voice": "tongtong",
    "bgm_gain_db": -18,
    "duck_db": -9,
    "sfx_gain_db": -14,
    "max_speed_up": 1.22,
    "line_gap_sec": 0.28,
    "lead_in_sec": 0.18,
    "target_loudness_lufs": -14
  },

  "subtitle": {
    "font": "Source Han Sans SC Medium",
    "font_size": 22,
    "languages": ["zh"],
    "margin_v": 42,
    "max_cps": 9.0,
    "min_dur_sec": 0.9,
    "burn_primary": false,
    "max_line_runes": 18,
    "max_lines": 2,
    "outline_width": 2
  }
}
